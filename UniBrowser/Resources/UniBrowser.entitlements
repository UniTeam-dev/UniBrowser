<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	No App Sandbox for now: the Apple Passwords bridge launches the system
	PasswordManagerBrowserExtensionHelper as a child process, the same way
	Chrome and Firefox do. Revisit before any Mac App Store build.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	iCloud session mirror (SyncService): to enable it, sign with a real Team and add,
	in Xcode ▸ Signing & Capabilities, the iCloud capability with CloudKit and the
	container iCloud.app.unibrowser.UniBrowser (which adds the two keys below). They are
	left out here because they need a development certificate and would break the ad-hoc
	build; without them the app runs local-only (sync status "iCloud недоступен").
		com.apple.developer.icloud-services            = [ CloudKit ]
		com.apple.developer.icloud-container-identifiers = [ iCloud.app.unibrowser.UniBrowser ]
	-->
</dict>
</plist>
