<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	No App Sandbox (website distribution), so the Apple Passwords bridge can launch
	the system PasswordManagerBrowserExtensionHelper as a child process, the way
	Chrome and Firefox do.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Hardened runtime: getUserMedia and navigator.geolocation for sites the user allowed. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
