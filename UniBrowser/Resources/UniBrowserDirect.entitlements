<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Website build: no App Sandbox, so the Apple Passwords bridge can launch the
	system PasswordManagerBrowserExtensionHelper as a child process, the way
	Chrome and Firefox do. The App Store build uses UniBrowser.entitlements.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
