<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>UniBrowser</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A browser must open http:// sites (home-network ones too); without this WKWebView fails them with -1022. Web views only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Downloads land in Documents, which «Файлы» shows under «На iPhone → UniBrowser». -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- WebKit asks for these only when a site the user opened calls getUserMedia or navigator.geolocation. -->
	<key>NSCameraUsageDescription</key>
	<string>Сайт, которому вы разрешили, использует камеру — например, для видеозвонка.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Сайт, которому вы разрешили, использует микрофон — например, для звонка.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Сайт, которому вы разрешили, узнаёт вашу геопозицию — например, чтобы показать карту.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>UniBrowser подключается к вашему Mac в режиме «Через Mac».</string>
	<!-- Only standard encryption (HTTPS, QUIC/TLS in iroh, CryptoKit): exempt from export filings. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.unibrowser.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unibrowser</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
